{
    "name": "imtiyazmir/school-fees-portal",
    "type": "project",
    "description": "A school fee collection and family receipt portal",
    "require": {
        "php": "^8.2",
        "ext-pdo_pgsql": "*",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
